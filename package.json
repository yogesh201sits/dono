{
  "name": "dono",
  "version": "0.1.0",
  "description": "A lightweight, type-safe asynchronous task scheduling library",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "bun --watch test",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
